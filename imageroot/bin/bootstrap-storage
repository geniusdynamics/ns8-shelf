#
# Create the Supabase Storage buckets Shelf needs, if they do not exist.
# Idempotent. The requests go through the loopback port of the pod, the
# service role key is read from the private passwords file and never printed.
#

import json
import os
import sys
import time
import urllib.error
import urllib.request

# Same as the buckets documented by Shelf: name -> public
BUCKETS = {
    "profile-pictures": True,
    "assets": False,
    "kits": False,
    "files": True,
}

home = os.path.expanduser("~")
state_dir = os.environ.get("AGENT_STATE_DIR") or os.path.join(home, ".config", "state")
base_url = f"http://127.0.0.1:{os.environ['TCP_PORT']}/storage/v1"


def read_service_key():
    with open(os.path.join(state_dir, "passwords.env")) as fp:
        for line in fp:
            if line.startswith("SERVICE_ROLE_KEY="):
                return line.rstrip("\n").split("=", 1)[1]
    raise RuntimeError("SERVICE_ROLE_KEY is missing from passwords.env")


def request(method, path, key, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(base_url + path, data=data, method=method, headers={
        "Authorization": "Bearer " + key,
        "apikey": key,
        "Content-Type": "application/json",
    })
    with urllib.request.urlopen(req, timeout=10) as res:
        return json.load(res)


def main():
    key = read_service_key()
    existing = None
    deadline = time.time() + 70
    while existing is None:
        try:
            existing = {b["name"] for b in request("GET", "/bucket", key)}
        except (urllib.error.URLError, OSError, ValueError) as ex:
            if time.time() > deadline:
                print(f"Supabase Storage is not ready: {ex}", file=sys.stderr)
                sys.exit(1)
            time.sleep(3)
    for name, public in BUCKETS.items():
        if name in existing:
            continue
        request("POST", "/bucket", key, {"id": name, "name": name, "public": public})
        print(f"Created storage bucket {name}", file=sys.stderr)


if __name__ == "__main__":
    main()
