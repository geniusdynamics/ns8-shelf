#!/usr/bin/env python3
"""Grant or revoke the Shelf instance-admin role for an existing account."""
import argparse
import subprocess

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("action", choices=("grant", "revoke"))
parser.add_argument("email", help="Exact email address of an existing Shelf account")
args = parser.parse_args()
statements = {
    "grant": """
        INSERT INTO "_RoleToUser" ("A", "B")
        SELECT role_id, user_id FROM target
        ON CONFLICT DO NOTHING
        RETURNING 1
    """,
    "revoke": """
        DELETE FROM "_RoleToUser" AS membership USING target
        WHERE membership."A" = target.role_id AND membership."B" = target.user_id
        RETURNING 1
    """,
}
local_account = 'AND member."deletedAt" IS NULL AND NOT member.sso' if args.action == "grant" else ""
sql = f"""
    WITH target AS (
        SELECT role.id AS role_id, member.id AS user_id
        FROM "Role" AS role, "User" AS member
        WHERE role.name = 'ADMIN' AND member.email = :'email' {local_account}
    ), changed AS ({statements[args.action]})
    SELECT EXISTS (SELECT FROM target), EXISTS (SELECT FROM changed);
"""
result = subprocess.run(
    ["podman", "exec", "-i", "shelf-db", "psql", "-XAt", "-v", "ON_ERROR_STOP=1",
     "-h", "127.0.0.1", "-U", "postgres", "-d", "postgres", "-v", f"email={args.email}"],
    input=sql, text=True, stdout=subprocess.PIPE, check=True,
).stdout.strip()
if result == "t|t":
    print("Shelf administrator role updated.")
elif result == "t|f":
    print("Shelf administrator role already has the requested state.")
else:
    raise SystemExit("No eligible Shelf account or administrator role was found.")
