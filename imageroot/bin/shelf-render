#!/usr/bin/env python3
import os

import agent
from shelf import env, secrets_file, token

credentials = secrets_file()
host = os.environ["TRAEFIK_HOST"]
url = f"https://{host}"
password = credentials["password"]
jwt = credentials["jwt"]
anon, service = (token(jwt, role) for role in ("anon", "service_role"))
signup = os.getenv("SHELF_ALLOW_SIGNUP") == "True"
saml = os.getenv("SHELF_SAML") == "True"
sender = os.getenv("SHELF_SMTP_FROM") or f"no-reply@{host}"
relay = agent.get_smarthost_settings(agent.redis_connect(use_replica=True))
smtp = relay["enabled"] and bool(relay["host"])
def db(role):
    return f"postgresql://{role}:{password}@127.0.0.1:5432/postgres"

env("shelf-db", POSTGRES_PASSWORD=password, PGPASSWORD=password,
    POSTGRES_HOST="/var/run/postgresql", POSTGRES_PORT=5432, PGPORT=5432,
    POSTGRES_DB="postgres")
env("shelf-auth", GOTRUE_API_HOST="127.0.0.1", GOTRUE_API_PORT=9999,
    API_EXTERNAL_URL=url, GOTRUE_SITE_URL=url,
    GOTRUE_URI_ALLOW_LIST=f"{url}/oauth/callback,{url}/oauth/callback/mobile",
    GOTRUE_DB_DRIVER="postgres", GOTRUE_DB_DATABASE_URL=db("supabase_auth_admin"),
    GOTRUE_JWT_SECRET=jwt, GOTRUE_JWT_ADMIN_ROLES="service_role",
    GOTRUE_JWT_AUD="authenticated", GOTRUE_JWT_DEFAULT_GROUP_NAME="authenticated",
    GOTRUE_JWT_EXP=3600, GOTRUE_EXTERNAL_EMAIL_ENABLED="true",
    GOTRUE_DISABLE_SIGNUP=str(not (signup and smtp)).lower(),
    GOTRUE_MAILER_AUTOCONFIRM="false",
    GOTRUE_MAILER_OTP_LENGTH=6,
    GOTRUE_MAILER_TEMPLATES_CONFIRMATION="http://127.0.0.1:18081/otp.html",
    GOTRUE_MAILER_TEMPLATES_MAGIC_LINK="http://127.0.0.1:18081/otp.html",
    GOTRUE_MAILER_TEMPLATES_RECOVERY="http://127.0.0.1:18081/otp.html",
    GOTRUE_SMTP_HOST=relay["host"] if smtp else "",
    GOTRUE_SMTP_PORT=relay["port"], GOTRUE_SMTP_USER=relay["username"] if smtp else "",
    GOTRUE_SMTP_PASS=relay["password"] if smtp else "", GOTRUE_SMTP_ADMIN_EMAIL=sender,
    GOTRUE_SMTP_SENDER_NAME="Shelf",
    GOTRUE_MAILER_URLPATHS_INVITE="/auth/v1/verify",
    GOTRUE_MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify",
    GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify",
    GOTRUE_MAILER_URLPATHS_RECOVERY="/auth/v1/verify",
    GOTRUE_SAML_ENABLED=str(saml).lower(),
    GOTRUE_SAML_PRIVATE_KEY=credentials["saml"] if saml else "",
    GOTRUE_SAML_EXTERNAL_URL=f"{url}/auth/v1" if saml else "")
env("shelf-rest", PGRST_DB_URI=db("authenticator"), PGRST_DB_SCHEMAS="public",
    PGRST_DB_ANON_ROLE="anon", PGRST_JWT_SECRET=jwt, PGRST_SERVER_HOST="127.0.0.1",
    PGRST_SERVER_PORT=3000)
env("shelf-storage", ANON_KEY=anon, SERVICE_KEY=service,
    POSTGREST_URL="http://127.0.0.1:3000", AUTH_JWT_SECRET=jwt,
    DATABASE_URL=db("supabase_storage_admin"), STORAGE_PUBLIC_URL=url,
    REQUEST_ALLOW_X_FORWARDED_PATH="true", FILE_SIZE_LIMIT=52428800,
    STORAGE_BACKEND="file", GLOBAL_S3_BUCKET="shelf", TENANT_ID="shelf", REGION="local",
    FILE_STORAGE_BACKEND_PATH="/var/lib/storage", ENABLE_IMAGE_TRANSFORMATION="false")
env("shelf-web", DATABASE_URL=db("postgres"), DIRECT_URL=db("postgres"),
    SUPABASE_URL=url, SERVER_URL=url, SUPABASE_ANON_PUBLIC=anon,
    SUPABASE_SERVICE_ROLE=service, SESSION_SECRET=credentials["session"],
    INVITE_TOKEN_SECRET=credentials["invite"],
    MAPTILER_TOKEN=os.getenv("SHELF_MAPTILER_TOKEN") or "unconfigured",
    SMTP_HOST=relay["host"] if smtp else "127.0.0.1",
    SMTP_PORT=relay["port"] if smtp else 25,
    SMTP_USER=relay["username"] if smtp else "", SMTP_PWD=relay["password"] if smtp else "",
    SMTP_FROM=sender, DISABLE_SIGNUP=str(not (signup and smtp)).lower(),
    DISABLE_SSO=str(not saml).lower(), ENABLE_SCIM="false",
    ENABLE_PREMIUM_FEATURES="false", SEND_ONBOARDING_EMAIL="false")
