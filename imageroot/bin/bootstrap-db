#!/bin/bash

#
# Copyright (C) 2023 Nethesis S.r.l.
# SPDX-License-Identifier: GPL-3.0-or-later
#

#
# Wait for PostgreSQL, then create the roles and the schemas required by the
# Supabase services. Idempotent: it runs at every start of postgres-app, so
# it also works on a restored or cloned database. The role passwords are read
# by psql from the environment of the container (see db-roles.sql).
#

set -e
exec 1>&2

etc_dir="${AGENT_INSTALL_DIR:-${HOME}/.config}/etc"

# The entrypoint of the image starts a temporary server that listens only on
# the Unix socket while it initializes a new data directory: wait for the
# final one, that listens on TCP.
ready=
for _ in $(seq 1 100); do
    if podman exec postgres-app pg_isready -q -h 127.0.0.1 -U postgres -d shelf; then
        ready=1
        break
    fi
    sleep 2
done
if [ -z "${ready}" ]; then
    echo "PostgreSQL did not become ready in time" 
    exit 1
fi

for sqlfile in db-roles.sql db-schemas.sql; do
    podman exec -i postgres-app psql -q -v ON_ERROR_STOP=1 -U postgres -d shelf < "${etc_dir}/${sqlfile}"
done
echo "Database roles and schemas are ready"
