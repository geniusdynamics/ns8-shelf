#!/usr/bin/env python3
"""Create missing buckets with default-deny write permissions."""
import json
import os
import time
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

from shelf import secrets_file, token

base = f"http://127.0.0.1:{os.environ['TCP_PORT']}"
service = token(secrets_file()["jwt"], "service_role")
headers = {"Authorization": f"Bearer {service}", "apikey": service,
           "Content-Type": "application/json"}


def request(path, payload=None):
    data = json.dumps(payload).encode() if payload is not None else None
    with urlopen(Request(base + path, headers=headers, data=data), timeout=5) as response:
        return json.load(response)


for attempt in range(45):
    try:
        request("/auth/v1/health")
        existing = {bucket["id"]: bucket for bucket in request("/storage/v1/bucket")}
    except (OSError, URLError, ValueError):
        if attempt == 44:
            raise SystemExit("Supabase Auth or Storage failed to become ready.")
        time.sleep(2)
    else:
        break

for name, public in (("profile-pictures", True), ("assets", False),
                     ("kits", False), ("files", True)):
    if name not in existing:
        try:
            request("/storage/v1/bucket", {"id": name, "name": name, "public": public})
        except HTTPError as error:
            raise SystemExit(f"Could not initialize Shelf bucket {name} (HTTP {error.code}).")
    elif existing[name]["public"] != public:
        raise SystemExit(f"Unexpected visibility for Shelf bucket {name}.")
