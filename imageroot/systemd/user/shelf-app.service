#
# Shelf web application. The container applies the pending database
# migrations before it starts the server.
#

[Unit]
Description=Podman shelf-app.service
BindsTo=shelf.service
After=shelf.service postgres-app.service gateway-app.service gotrue-app.service storage-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/shelf-app.pid %t/shelf-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/shelf-app.pid \
    --cidfile %t/shelf-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/shelf.pod-id --replace -d --name shelf-app \
    --env-file=%S/state/shelf.env \
    --env NODE_EXTRA_CA_CERTS=/etc/shelf-tls/server.crt \
    --volume %S/state/internal-tls/server.crt:/etc/shelf-tls/server.crt:ro,z \
    ${SHELF_NU_IMAGE}
# Create the storage buckets Shelf needs, if missing. Best effort: it is
# repeated at every start, see bin/bootstrap-storage
ExecStartPost=-runagent bootstrap-storage
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/shelf-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/shelf-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/shelf-app.pid
Type=forking

[Install]
WantedBy=default.target
