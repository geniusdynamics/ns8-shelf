[Unit]
Description=Podman gotrue-app.service
BindsTo=shelf.service
After=shelf.service postgres-app.service gateway-app.service
Before=shelf-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/gotrue-app.pid %t/gotrue-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/gotrue-app.pid \
    --cidfile %t/gotrue-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/shelf.pod-id --replace -d --name gotrue-app \
    --env-file=%S/state/gotrue.env \
    ${GOTRUE_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/gotrue-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/gotrue-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/gotrue-app.pid
Type=forking

[Install]
WantedBy=default.target
