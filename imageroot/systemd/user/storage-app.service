#
# Supabase Storage: keeps the files uploaded to Shelf in the storage-data
# volume (file backend), the metadata is in the database.
#

[Unit]
Description=Podman storage-app.service
BindsTo=shelf.service
After=shelf.service postgres-app.service
Before=shelf-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/storage-app.pid %t/storage-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/storage-app.pid \
    --cidfile %t/storage-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/shelf.pod-id --replace -d --name storage-app \
    --env-file=%S/state/storage.env \
    --volume storage-data:/var/lib/storage:Z \
    ${STORAGE_API_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/storage-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/storage-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/storage-app.pid
Type=forking

[Install]
WantedBy=default.target
