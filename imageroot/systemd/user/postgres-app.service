#
# PostgreSQL: one database, "shelf", holds the data of Shelf (schema
# public) and of the Supabase services: Auth (schema auth) and Storage
# (schema storage). It is reachable only from inside the pod.
#

[Unit]
Description=Podman postgres-app.service
BindsTo=shelf.service
After=shelf.service
Before=gotrue-app.service storage-app.service shelf-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
TimeoutStartSec=240
ExecStartPre=/bin/rm -f %t/postgres-app.pid %t/postgres-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/postgres-app.pid \
    --cidfile %t/postgres-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/shelf.pod-id --replace -d --name postgres-app \
    --env-file=%S/state/postgres.env \
    --env TZ=UTC \
    --volume postgres-data:/var/lib/postgresql/data:Z \
    ${POSTGRES_IMAGE}
# Wait for the server, then create the roles and schemas the Supabase
# services expect (idempotent), see bin/bootstrap-db
ExecStartPost=runagent bootstrap-db
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/postgres-app.ctr-id -t 30
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/postgres-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/postgres-app.pid
Type=forking

[Install]
WantedBy=default.target
