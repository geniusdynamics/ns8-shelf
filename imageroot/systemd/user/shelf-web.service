[Unit]
Description=Shelf web and Prisma migrations
BindsTo=shelf.service
PartOf=shelf.service
After=shelf.service shelf-gateway.service
Requires=shelf-gateway.service

[Service]
Type=notify
NotifyAccess=all
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=on-failure
TimeoutStartSec=240
TimeoutStopSec=75
ExecStart=/usr/bin/podman run --replace --name %N --pod shelf --sdnotify=conmon --cgroups=no-conmon \
    --env-file=%E/state/shelf-web.env \
    ${SHELF_NU_IMAGE}
ExecStartPost=/usr/bin/timeout 180 /usr/bin/bash -c 'until curl -fsS "http://127.0.0.1:${TCP_PORT}/healthcheck" >/dev/null; do sleep 2; done'
ExecStop=/usr/bin/podman stop --ignore -t 25 %N
ExecStopPost=/usr/bin/podman rm --ignore -f %N
