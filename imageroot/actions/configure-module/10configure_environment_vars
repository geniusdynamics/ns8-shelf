#!/usr/bin/env python3
import json
import sys
import agent

data = json.load(sys.stdin)
agent.mset_env({
    "TRAEFIK_HOST": data["host"],
    "TRAEFIK_HTTP2HTTPS": data.get("http2https", True),
    "SHELF_ALLOW_SIGNUP": data.get("allow_signup", False),
    "SHELF_SAML": data.get("saml", False),
    "SHELF_SMTP_FROM": data.get("smtp_from", ""),
    "SHELF_MAPTILER_TOKEN": data.get("maptiler_token", ""),
})
