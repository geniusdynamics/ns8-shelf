#!/usr/bin/env python3
import json
import os
import sys
import agent

data = json.load(sys.stdin)
env = os.environ

# Optional settings that are not sent keep their current value
agent.mset_env({
    "TRAEFIK_HOST": data["host"],
    "TRAEFIK_HTTP2HTTPS": data.get("http2https", env.get("TRAEFIK_HTTP2HTTPS", "True") == "True"),
    "SHELF_ALLOW_SIGNUP": data.get("allow_signup", env.get("SHELF_ALLOW_SIGNUP") == "True"),
    "SHELF_SAML": data.get("saml", env.get("SHELF_SAML") == "True"),
    "SHELF_SMTP_FROM": data.get("smtp_from", env.get("SHELF_SMTP_FROM", "")),
    "SHELF_MAPTILER_TOKEN": data.get("maptiler_token", env.get("SHELF_MAPTILER_TOKEN", "")),
})
