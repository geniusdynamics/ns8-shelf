import agent
import os

# state/ and the volumes were copied from the source module, secrets and
# settings included. lets_encrypt stays off: the DNS may not point to the
# destination node yet, the admin turns it on later.
configure_retval = agent.tasks.run(agent_id=os.environ['AGENT_ID'], action='configure-module', data={
    "host": os.environ["TRAEFIK_HOST"],
    "lets_encrypt": False,
    "disable_signup": os.environ.get("SHELF_DISABLE_SIGNUP", "false").lower() == "true",
    "mail_from": os.environ.get("SHELF_MAIL_FROM", ""),
})
agent.assert_exp(configure_retval['exit_code'] == 0, "The configure-module subtask failed!")
