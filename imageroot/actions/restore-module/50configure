import sys
import json
import agent
import os

request = json.load(sys.stdin)
renv = request['environment']

# Pass every setting of configure-module, otherwise the admin's choices are
# silently reset. lets_encrypt is deliberately left off: the DNS may not point
# to this node yet and the certificate request would fail the whole restore.
# The MapTiler token is restored with state/settings.env.
configure_retval = agent.tasks.run(agent_id=os.environ['AGENT_ID'], action='configure-module', data={
    "host": renv["TRAEFIK_HOST"],
    "lets_encrypt": False,
    "disable_signup": renv.get("SHELF_DISABLE_SIGNUP", "false").lower() == "true",
    "mail_from": renv.get("SHELF_MAIL_FROM", ""),
})
agent.assert_exp(configure_retval['exit_code'] == 0, "The configure-module subtask failed!")
