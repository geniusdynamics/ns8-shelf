# Stop the services, so that PostgreSQL shuts down cleanly. The Traefik
# route is dropped by ns8-traefik on the module-removed event; the volumes
# are removed with the module.
exec 1>&2

systemctl --user disable --now shelf.service postgres-app.service gateway-app.service gotrue-app.service storage-app.service shelf-app.service || true
