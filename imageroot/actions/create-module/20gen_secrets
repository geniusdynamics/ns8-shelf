#
# Generate the module secrets once, at creation. They are stored in
# state/passwords.env with mode 0600, never in the Redis-backed environment:
# the file is saved by the backup (etc/state-include.conf), copied by clone
# and restored with the module, so the access keys and the sessions stay valid.
#

import base64
import hashlib
import hmac
import json
import os
import secrets
import sys
import time

state_dir = os.environ["AGENT_STATE_DIR"]
os.umask(0o077)


def b64url(raw):
    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode()


def supabase_key(secret, role):
    """HS256 JWT of a Supabase API key: the role selects the privileges."""
    now = int(time.time())
    header = b64url(json.dumps({"alg": "HS256", "typ": "JWT"}, separators=(",", ":")).encode())
    claims = b64url(json.dumps({
        "role": role,
        "iss": "supabase",
        "iat": now,
        "exp": now + 10 * 365 * 24 * 3600,
    }, separators=(",", ":")).encode())
    signature = hmac.new(secret.encode(), f"{header}.{claims}".encode(), hashlib.sha256).digest()
    return f"{header}.{claims}.{b64url(signature)}"


def create_private_file(name, content):
    """Create a file readable by the module only. Never overwrite."""
    try:
        fd = os.open(os.path.join(state_dir, name), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        print(f"{name} already exists, kept", file=sys.stderr)
        return
    with os.fdopen(fd, "w") as fp:
        fp.write(content)


jwt_secret = secrets.token_hex(32)
create_private_file("passwords.env", "".join(f"{k}={v}\n" for k, v in {
    "POSTGRES_PASSWORD": secrets.token_hex(24),
    "AUTH_DB_PASSWORD": secrets.token_hex(24),
    "STORAGE_DB_PASSWORD": secrets.token_hex(24),
    "JWT_SECRET": jwt_secret,
    "ANON_KEY": supabase_key(jwt_secret, "anon"),
    "SERVICE_ROLE_KEY": supabase_key(jwt_secret, "service_role"),
    "SESSION_SECRET": secrets.token_hex(32),
    "INVITE_TOKEN_SECRET": secrets.token_hex(32),
}.items()))
# Optional settings, written by configure-module
create_private_file("settings.env", "")
