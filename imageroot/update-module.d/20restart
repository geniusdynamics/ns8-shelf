# Restart the services, only if they are running, so the new images and the
# regenerated env files (bin/render-env runs when the pod starts) are used.
# The Shelf container applies its database migrations on start.

set -e

# Redirect any output to the journal (stderr)
exec 1>&2

systemctl --user try-restart shelf.service postgres-app.service gateway-app.service gotrue-app.service storage-app.service shelf-app.service
